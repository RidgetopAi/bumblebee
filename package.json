{
  "name": "bumblebee",
  "version": "1.0.0",
  "description": "CLI Markdown Viewer & Editor - Neovim-style terminal application (Ink + React)",
  "type": "module",
  "scripts": {
    "dev": "node --loader tsx src/cli.ts",
    "build": "npx tsc && chmod +x dist/cli.js",
    "test": "vitest",
    "stdout": "node --loader tsx src/cli.ts --stdout"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RidgetopAi/bumblebee.git"
  },
  "keywords": [
    "markdown",
    "cli",
    "viewer",
    "editor",
    "terminal",
    "ink",
    "react"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/RidgetopAi/bumblebee/issues"
  },
  "homepage": "https://github.com/RidgetopAi/bumblebee#readme",
  "dependencies": {
    "chalk": "^5.6.2",
    "cli-highlight": "^2.1.11",
    "commander": "^14.0.1",
    "gray-matter": "^4.0.3",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "shiki": "^3.13.0",
    "string-width": "^8.1.0",
    "strip-ansi": "^7.1.2",
    "wrap-ansi": "^9.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "comments": {
    "phase2-dependencies": "Phase 2 will add: ink, react, ink-spinner, ink-text-input, clipboardy, chokidar"
  }
}
